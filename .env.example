# Copy this file to `.env` and fill in the real values.
# All EXPO_PUBLIC_* vars are inlined into the app bundle at build time.

# --- Required ---
# SWFR canteen API key (request from the project lead). Without it the
# canteen (Mensa) tab cannot load data.
EXPO_PUBLIC_SWFR_API_KEY=your-swfr-api-key-here

# --- Optional (safe defaults exist; leave unset for normal development) ---

# Show the rides/carpool UI in the schedule header. Default: false.
# Accepts: true/false, 1/0, on/off, yes/no.
EXPO_PUBLIC_RIDES_ENABLED=false

# Source for the rides index JSON: "remote" (default) or "file" (dev-only,
# loads scripts/courses-rides.json locally).
EXPO_PUBLIC_RIDES_SOURCE=remote

# Override the rides index URL. Default (when unset):
# https://data.apps.szi.dhbw-loerrach.de/courses-rides.json
# EXPO_PUBLIC_RIDES_URL=

# Show the block plan (Blockplan) icon in the schedule header. Off by default
# because the plan API is not live yet; while it is off, no request is made.
# EXPO_PUBLIC_BLOCKPLAN_ENABLED=true
#
# Override the block plan (Blockplan) API URL. `{course}` is replaced with the
# uppercase course code (e.g. TIF26A). Default (when unset):
# https://plan.apps.szi.dhbw-loerrach.de/api/v1/courses/{course}/block-plan
# EXPO_PUBLIC_BLOCKPLAN_URL=
#
# Until the real API is live you can serve a sample payload locally. The
# template only has to end up at valid JSON, so the mock may use a flat layout:
#   npx serve scripts --cors --listen 3001
#   EXPO_PUBLIC_BLOCKPLAN_URL=http://localhost:3001/blockplan-{course}.json
# (use your machine's LAN IP instead of localhost when testing on a device)
#
# `scripts/*.json` is gitignored, so create the file yourself, e.g.
# scripts/blockplan-TIF26A.json:
#   {"course":{"code":"TIF26A"},"semesters":[{"number":1,"phases":[
#     {"type":"THEORY","startDate":"2026-10-01","endDate":"2026-12-20"},
#     {"type":"PRACTICE","startDate":"2026-12-21","endDate":"2027-04-18"}]}]}
